record(ai, "$(P):RF9:AvgVolt")
{
    field(SCAN, "1 second")
    field(DTYP, "VoltCalc")
    field(INP,  "@6")
    field(DESC, "RF9 average voltage")
    field(EGU,  "V")
    field(PREC, "6")
