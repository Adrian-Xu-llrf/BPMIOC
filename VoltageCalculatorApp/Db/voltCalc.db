record(ai, "$(P):RF8:AvgVolt")
{
    field(SCAN, "1 second")
    field(DTYP, "VoltCalc")
    field(INP,  "@5")
    field(DESC, "RF8 average voltage")
    field(EGU,  "V")
    field(PREC, "6")
}

